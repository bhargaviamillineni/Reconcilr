[run]
omit = 
    */tests/*
    */test_*.py
    app.py
    main.py
    generate_data.py
    venv/*
    .venv/*
    */site-packages/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
