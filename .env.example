# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Choose ONE provider: openai, gemini, or groq
# Copy this file to .env and fill in your actual API keys (NEVER commit .env!)

LLM_PROVIDER=groq

# -----------------------------------------------------------------------------
# OpenAI Configuration
# -----------------------------------------------------------------------------
# Get your API key at: https://platform.openai.com/api-keys
# Cost: ~$0.0005 per API call (gpt-4o-mini)
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Gemini Configuration
# -----------------------------------------------------------------------------
# Get a FREE API key at: https://aistudio.google.com/app/apikey
# Cost: ~$0.0001 per API call (gemini-1.5-flash)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# Groq Configuration (RECOMMENDED - fast & nearly free!)
# -----------------------------------------------------------------------------
# Get a FREE API key at: https://console.groq.com/keys
# Cost: ~$0.00001 per API call (essentially free!)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# =============================================================================
# SECURITY WARNING
# =============================================================================
# NEVER commit your .env file with real API keys to version control!
# The .env file is gitignored by default - keep it that way.
# If you accidentally commit keys, IMMEDIATELY:
# 1. Revoke the exposed keys at the provider's console
# 2. Generate new keys
# 3. Remove .env from git history: git rm --cached .env
# =============================================================================
